NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# New API keys (Settings → API Keys in Supabase Dashboard)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: used as fallback for password-reset email links and cron email CTAs
# NEXT_PUBLIC_SITE_URL=https://www.andihaskel.space

# Legacy fallback (still works during migration, not recommended)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Backend only — never expose to browser.
# Required for daily due-commitment emails (cron).
# SUPABASE_SECRET_KEY=sb_secret_...
# Legacy: SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Vercel Cron auth (Authorization: Bearer …). Also set in Vercel project env.
# CRON_SECRET=generate-a-long-random-string

# Resend (https://resend.com) — daily due reminders
# RESEND_API_KEY=re_...
# EMAIL_FROM=financeX <noreply@andihaskel.space>
