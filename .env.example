NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# New API keys (Settings → API Keys in Supabase Dashboard)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: used as fallback for password-reset email links
# NEXT_PUBLIC_SITE_URL=https://www.andihaskel.space

# Legacy fallback (still works during migration, not recommended)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Backend only — never expose to browser. Not required for this app today.
# SUPABASE_SECRET_KEY=sb_secret_...
